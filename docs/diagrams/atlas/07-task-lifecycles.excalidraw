      "id": "op_note",
      "type": "text",
      "x": 310,
      "y": 980,
      "width": 1350,
      "height": 55,
      "fontSize": 20,
      "text": "Known outcomes can settle directly. Uncertain writes require status/receipt reconciliation; retain associated holds.\nLease expiry, cancellation, and a new run do not prove non-execution or authorize a fresh duplicate.",
      "originalText": "Known outcomes can settle directly. Uncertain writes require status/receipt reconciliation; retain associated holds.\nLease expiry, cancellation, and a new run do not prove non-execution or authorize a fresh duplicate.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
