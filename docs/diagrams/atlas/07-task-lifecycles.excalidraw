      "id": "del_note",
      "type": "text",
      "x": 310,
      "y": 1240,
      "width": 1350,
      "height": 55,
      "fontSize": 20,
      "text": "Before sending: suppress, batch, or supersede an obsolete notice. Known delivery may acknowledge directly.\nUnknown delivery follows provider-specific recovery; no universal exactly-once messaging promise.",
      "originalText": "Before sending: suppress, batch, or supersede an obsolete notice. Known delivery may acknowledge directly.\nUnknown delivery follows provider-specific recovery; no universal exactly-once messaging promise.",
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
