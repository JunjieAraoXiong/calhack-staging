      "id": "bypass",
      "type": "text",
      "x": 45,
      "y": 815,
      "width": 330,
      "height": 180,
      "fontSize": 22,
      "text": "Late-evidence path\n\nStill accepted after cancellation,\nold spec rejection, or exhausted\nplanning budget.\n\nIt never authorizes a new effect.",
      "originalText": "Late-evidence path\n\nStill accepted after cancellation,\nold spec rejection, or exhausted\nplanning budget.\n\nIt never authorizes a new effect.",
