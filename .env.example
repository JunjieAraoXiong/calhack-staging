# Frontend: generated automatically by local Convex setup; not a secret.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Model settings belong in Convex's SERVER environment, not the Vite bundle.
# Set with `npx convex env set NAME value`, while npm run backend is running.
# Default local live mode uses the already signed-in Codex CLI. No token is exported.
# ARRIVAL_MODEL_PROVIDER=codex-cli
# ARRIVAL_MODEL=gpt-6.1-sol
# ARRIVAL_CODEX_BIN=absolute-path-to-codex
# Alternative server provider:
# ARRIVAL_MODEL_PROVIDER=openai
# ARRIVAL_MODEL=your-supported-openai-model
# OPENAI_API_KEY=your-server-side-key

# Local Convex CLI creates CONVEX_DEPLOYMENT in .env.local.
# Do not point this demonstration at an unrelated or production deployment.
